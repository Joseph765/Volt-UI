    {
        "name": "Banner",
        "description": "A prominent full-width strip that displays important messages, alerts, or announcements with optional actions.",
        "example": "<div class='m-banner' style='width: calc(100% - var(--m-space-2xl)); border-color: var(--m-gray-9); background-color: var(--m-gray-3);'><div class='m-banner-icon'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><path d='M12 16v-4'/><path d='M12 8h.01'/></svg></div>Banner</div>"
    },
    {
        "name": "Button",
        "description": "An interactive element that triggers actions or submits forms when clicked.",
        "example": "<span class='m-button' style='background-color: var(--m-gray-5); border-color: var(--m-gray-5); color: var(--m-color-text);'>Button</span>"
    },
    {
        "name": "Card",
        "description": "A contained surface that groups related content and actions in a visually distinct block.",
        "example": "<div class='m-card has-space-m'><div class='m-card-content'>Card</div></div>"
    },
    {
        "name": "Checkbox",
