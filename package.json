{
	"name": "moth-ui-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build -w moth-ui-docs && npm run build -w moth-ui-react",
		"dev": "npm run dev -w moth-ui-docs",
		"dev:react": "npm run dev -w moth-ui-react-playground",
		"check": "npm run check -w moth-ui-docs",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"changeset": "changeset",
		"version-packages": "changeset version && npm install --package-lock-only",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0"
	}
}
