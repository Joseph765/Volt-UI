{
	"name": "moth-ui-svelte",
	"version": "0.2.0",
	"description": "A design system with a look all its own, for Svelte and React. This is the Svelte package.",
	"author": "Joseph Chauvin (https://github.com/Joseph765)",
	"license": "MIT",
	"homepage": "https://moth-ui.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Joseph765/moth-ui.git",
		"directory": "packages/svelte"
	},
	"bugs": {
		"url": "https://github.com/Joseph765/moth-ui/issues"
	},
	"keywords": [
		"design-system",
		"svelte",
		"svelte5",
		"ui-library",
		"svelte-components",
		"component-library"
	],
	"scripts": {
		"build": "svelte-package && node scripts/copy-css.js",
		"dev": "svelte-package --watch",
		"prepack": "npm run build && publint"
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./css/*": "./dist/css/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.7",
		"publint": "^0.3.15",
		"svelte": "^5.45.6",
		"typescript": "^5.9.3"
	}
}
